//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  ICT Fractal Models · NEW-TV-Framework
//
//  One engine, ten ICT models:
//      liquidity sweep → shift (MSS / CISD) → PD array → confirmation close
//
//  • Entries are market orders on the close of a confirmation candle.
//    Nothing ever rests as a limit order inside a PD array.
//  • No SMT divergence, no sessions, killzones or time windows.
//  • Fractal: every rule is measured in bars and ATR, never in clock time, and
//    the HTF is picked relative to the chart, so the same models run on any TF.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("ICT Fractal Models", "ICT FM", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1500) // @ind
//@S strategy("ICT Fractal Models [Strategy]", "ICT FM S", overlay = true, process_orders_on_close = true, initial_capital = 100000, pyramiding = 0, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1500)

// ─── Constants ────────────────────────────────────────────────────────────────
// Models
int TS   = 0   // Turtle Soup
int SB   = 1   // Sweep → FVG (Silver Bullet logic without the session)
int UNI  = 2   // Unicorn: breaker ∩ FVG
int M1   = 3   // HTF POI + shift + FVG
int M2   = 4   // HTF POI + shift + IDM + FVG
int M3   = 5   // HTF POI + shift + FVG + OTE
int M4   = 6   // Box setup: consolidation sweep → reclaim → retest
int IFV  = 7   // Inversion FVG
int OBF  = 8   // OB + FVG convergence
int CONT = 9   // FVG continuation
int NM   = 10

// PD array kinds
int K_FVG  = 0
int K_IFVG = 1
int K_OB   = 2
int K_BB   = 3
int K_HFVG = 4
int K_HOB  = 5

// Liquidity pool kinds
int P_SWING = 0
int P_EQ    = 1
int P_HTF   = 2

color C_SWEEP = #ff9800

// ─── Inputs · Models ──────────────────────────────────────────────────────────
string G_MOD = "Models"
bool   enTS   = input.bool(true, "Turtle Soup", group = G_MOD, tooltip = "External liquidity is swept and reclaimed within the Turtle Soup window (false break) → MSS → the retrace runs the internal low/high formed after the shift ($) → entry on the close that reclaims it.")
bool   enSB   = input.bool(true, "Sweep → FVG (Silver Bullet, no session)", group = G_MOD, tooltip = "Liquidity sweep, then the displacement off the sweep extreme prints an FVG. Entry when price returns to the FVG and confirms. The Silver Bullet time windows are removed, so it runs on every timeframe.")
bool   enUNI  = input.bool(true, "Unicorn (Breaker ∩ FVG)", group = G_MOD, tooltip = "An order block fails after a stop run and becomes a breaker. The displacement through it prints an FVG that overlaps the breaker. Entry on the return into the overlap.")
bool   enM1   = input.bool(true, "M1 · HTF POI + Shift + FVG", group = G_MOD, tooltip = "Checklist: HTF liquidity grab / HTF POI · MSS (shift) · FVG of the shift leg in discount (premium for shorts) · good R:R.")
bool   enM2   = input.bool(true, "M2 · HTF POI + Shift + IDM + FVG", group = G_MOD, tooltip = "M1 plus inducement: an internal low/high forms after the shift, beyond the FVG, and must be swept before the FVG is tapped. A tap before the IDM is taken cancels the plan.")
bool   enM3   = input.bool(true, "M3 · HTF POI + Shift + FVG + OTE", group = G_MOD, tooltip = "M1 where the FVG overlaps the 0.62–0.79 OTE retracement of the shift leg and price reaches 0.62.")
bool   enM4   = input.bool(true, "M4 · Box Setup", group = G_MOD, tooltip = "Consolidation range → liquidity grab beyond the range (EQL/EQH) → close back inside → price leaves the range on the other side and retests it → entry.")
bool   enIFV  = input.bool(true, "iFVG Inversion", group = G_MOD, tooltip = "After a sweep, an opposing FVG is closed through and inverts (iFVG). Entry on the retest of the iFVG.")
bool   enOBF  = input.bool(true, "OB + FVG Convergence", group = G_MOD, tooltip = "After the shift, the order block that launched the displacement sits directly under (over) a shift-leg FVG. Entry when price reaches the OB.")
bool   enCONT = input.bool(false, "FVG Continuation", group = G_MOD, tooltip = "After the shift leg, each new FVG printed while the leg delivers toward opposing liquidity. Stop beyond the FVG's first candle.")
string dirIn  = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = G_MOD)

// ─── Inputs · Structure & liquidity ──────────────────────────────────────────
string G_STR = "Structure & Liquidity"
int    extLen    = input.int(6, "External swing length", minval = 2, maxval = 50, group = G_STR, tooltip = "Pivot bars (left = right) for external liquidity: BSL above swing highs, SSL below swing lows.")
int    intLen    = input.int(2, "Internal swing length", minval = 1, maxval = 20, group = G_STR, tooltip = "Pivot bars for internal structure: MSS levels, IDM / internal liquidity ($) and order blocks.")
float  eqTol     = input.float(0.1, "Equal highs / lows tolerance (× ATR)", minval = 0, step = 0.05, group = G_STR, tooltip = "Swing pools closer than this merge into one EQH / EQL pool.")
string shiftIn   = input.string("MSS", "Shift confirmation", options = ["MSS", "CISD", "MSS or CISD"], group = G_STR, tooltip = "MSS: close through the internal swing that delivered price into the sweep.\nCISD: close through the open of the run of opposite candles that delivered price into the sweep extreme.")
int    maxShift  = input.int(30, "Max bars sweep → shift", minval = 2, group = G_STR)
int    setupLife = input.int(150, "Setup life after shift (bars)", minval = 10, group = G_STR)
int    tsBars    = input.int(3, "Turtle Soup reclaim window (bars)", minval = 1, maxval = 20, group = G_STR, tooltip = "A sweep counts as a false break only when price closes back inside the swept level within this many bars. The same window applies to reclaiming the internal $ level.")
int    poolLife  = input.int(500, "Liquidity pool life (bars)", minval = 50, group = G_STR)

// ─── Inputs · PD arrays ──────────────────────────────────────────────────────
string G_PD = "PD Arrays"
float  fvgMin   = input.float(0.1, "Min FVG size (× ATR)", minval = 0, step = 0.05, group = G_PD)
int    grace    = input.int(3, "Shift leg window (bars after shift)", minval = 0, maxval = 20, group = G_PD, tooltip = "FVGs printed from the sweep extreme up to this many bars after the shift belong to the shift leg (M1, M2, M3, OB+FVG). Later FVGs are continuation FVGs.")
int    sbBars   = input.int(15, "Sweep → FVG max bars", minval = 2, group = G_PD)
int    ifvBars  = input.int(20, "iFVG max bars after sweep", minval = 2, group = G_PD)
int    uniBars  = input.int(5, "Unicorn max bars breaker ↔ FVG", minval = 0, group = G_PD)
int    uniAge   = input.int(50, "Unicorn max bars OB → breaker", minval = 5, group = G_PD, tooltip = "The order block must fail within this many bars of forming, so the breaker's stop run (the Unicorn stop) belongs to the same swing.")
float  obfTol   = input.float(0.25, "OB + FVG max gap (× ATR)", minval = 0, step = 0.05, group = G_PD)
int    contMax  = input.int(2, "Continuation FVGs per leg", minval = 1, maxval = 10, group = G_PD)
int    boxLen   = input.int(15, "M4 consolidation length (bars)", minval = 5, maxval = 200, group = G_PD)
float  boxAtr   = input.float(2.5, "M4 max consolidation height (× ATR)", minval = 0.5, step = 0.25, group = G_PD)
int    boxBars  = input.int(5, "M4 reclaim window (bars)", minval = 1, group = G_PD)
int    zoneLife = input.int(400, "PD array life (bars)", minval = 20, group = G_PD)

// ─── Inputs · HTF ─────────────────────────────────────────────────────────────
string G_HTF = "Higher Timeframe (fractal)"
string htfIn    = input.string("Auto ladder", "HTF", options = ["Auto ladder", "Manual"], group = G_HTF, tooltip = "Auto ladder picks the HTF from the chart: seconds→5m · 1m→15m · ≤5m→1H · ≤30m→4H · ≤1H→D · ≤4H→W · ≤D→M · ≤W→3M · above→12M.")
string htfMan   = input.timeframe("240", "Manual HTF", group = G_HTF, tooltip = "Used only when it is higher than the chart timeframe; otherwise the auto ladder is used.")
string htfReq   = input.string("M1–M4 (checklist)", "Require HTF POI / liquidity", options = ["M1–M4 (checklist)", "All models", "Off"], group = G_HTF, tooltip = "A setup passes when its sweep leg traded into an HTF FVG / OB on the trade's side, or took the previous HTF candle's high / low.")
bool   htfFvgOn = input.bool(true, "HTF FVG as POI", group = G_HTF)
bool   htfObOn  = input.bool(true, "HTF OB as POI", group = G_HTF)
bool   htfLiqOn = input.bool(true, "Previous HTF candle high / low as liquidity", group = G_HTF)
int    htfKeep  = input.int(6, "HTF POIs kept per side", minval = 1, maxval = 30, group = G_HTF)

// ─── Inputs · Entry & risk ────────────────────────────────────────────────────
string G_EN = "Entry & Risk · market on close, no limit orders"
string confIn   = input.string("CISD", "Confirmation after tap", options = ["CISD", "Rejection close", "Close in direction"], group = G_EN, tooltip = "Price first trades into the PD array (tap). The entry is the close of the first candle that confirms:\nCISD: closes through the open of the delivery into the tap.\nRejection close: closes back out of the zone in the trade direction.\nClose in direction: any candle closing in the trade direction without closing through the zone.\nTurtle Soup always confirms on its reclaim close.")
string tapIn    = input.string("Zone edge", "Tap depth", options = ["Zone edge", "CE (50%)"], group = G_EN)
int    confBars = input.int(10, "Confirmation window (bars after tap)", minval = 1, group = G_EN, tooltip = "If nothing confirms within this many bars of the tap, the tap is discarded and the next touch of the PD array starts a fresh one (CISD is measured from the new delivery).")
int    planLife = input.int(60, "Plan expiry (bars)", minval = 5, group = G_EN)
string stopIn   = input.string("Sweep extreme", "Stop", options = ["Sweep extreme", "PD array edge"], group = G_EN, tooltip = "Sweep extreme: beyond the liquidity sweep (the breaker's stop run for Unicorn, the FVG's first candle for Continuation).\nPD array edge: beyond the PD array or the tap wick, whichever is further.")
float  stopBuf  = input.float(0.1, "Stop buffer (× ATR)", minval = 0, step = 0.05, group = G_EN)
string tpIn     = input.string("Liquidity ≥ min R:R", "Target", options = ["Liquidity ≥ min R:R", "Nearest liquidity", "Fixed R"], group = G_EN, tooltip = "Liquidity ≥ min R:R: the closest untaken pool that pays at least the min R:R.\nNearest liquidity: the closest untaken pool; the trade is skipped when it pays less than the min R:R.\nFixed R: a fixed multiple of risk.\nWithout a pool beyond the entry, the leg extreme or the fixed R is used.")
float  minRR    = input.float(2.0, "Min R:R", minval = 0.5, step = 0.25, group = G_EN)
float  fixR     = input.float(3.0, "Fixed R (also the fallback when no pool exists)", minval = 0.5, step = 0.25, group = G_EN)
bool   onePer   = input.bool(true, "One open trade per model & side", group = G_EN)

// ─── Inputs · Display ─────────────────────────────────────────────────────────
string G_VIS = "Display"
bool   shLiq   = input.bool(true, "Liquidity pools", group = G_VIS)
bool   shStr   = input.bool(true, "Sweeps, shifts, IDM, $", group = G_VIS)
bool   shFvg   = input.bool(true, "FVG / iFVG", group = G_VIS)
bool   shOb    = input.bool(false, "Order blocks / breakers", group = G_VIS)
bool   shHtf   = input.bool(true, "HTF POIs", group = G_VIS)
bool   shBox   = input.bool(true, "M4 consolidation boxes", group = G_VIS)
bool   shPlan  = input.bool(true, "Armed PD arrays", group = G_VIS)
bool   shTrade = input.bool(true, "Entry / stop / target boxes", group = G_VIS)
bool   shDash  = input.bool(true, "Dashboard & checklist", group = G_VIS)
string dashPos = input.string("Top right", "Dashboard position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_VIS)
color  cBull   = input.color(#00bcd4, "Bullish", inline = "c1", group = G_VIS)
color  cBear   = input.color(#e91e63, "Bearish", inline = "c1", group = G_VIS)
color  cHtf    = input.color(#ab47bc, "HTF", inline = "c1", group = G_VIS)
color  cLiq    = input.color(#787b86, "Liquidity", inline = "c2", group = G_VIS)
color  cWin    = input.color(#089981, "Target", inline = "c2", group = G_VIS)
color  cLoss   = input.color(#f23645, "Stop", inline = "c2", group = G_VIS)

// ─── Core series (every bar, never inside conditions) ────────────────────────
float atr14   = ta.atr(14)
float A       = na(atr14) ? high - low : atr14
float ph      = ta.pivothigh(high, extLen, extLen)
float pl      = ta.pivotlow(low, extLen, extLen)
float iph     = ta.pivothigh(high, intLen, intLen)
float ipl     = ta.pivotlow(low, intLen, intLen)
float rHi     = ta.highest(high, boxLen)
float rLo     = ta.lowest(low, boxLen)
bool  tight   = not na(rHi[1]) and not na(rLo[1]) and rHi[1] - rLo[1] <= boxAtr * A[1]
bool  bullFvg = bar_index > 2 and low > high[2] and low - high[2] >= fvgMin * A and close[1] > open[1]
bool  bearFvg = bar_index > 2 and high < low[2] and low[2] - high >= fvgMin * A and close[1] < open[1]

// ─── HTF (fractal ladder) ─────────────────────────────────────────────────────
f_autoHtf() =>
    int s = timeframe.in_seconds()
    s < 60 ? "5" : s <= 60 ? "15" : s <= 300 ? "60" : s <= 1800 ? "240" : s <= 3600 ? "1D" : s <= 14400 ? "1W" : s <= 86400 ? "1M" : s <= 604800 ? "3M" : "12M"

f_tfTxt(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? str.tostring(int(s / 60)) + "m" : s < 86400 ? str.tostring(int(s / 3600)) + "H" : tf

string htfTf = htfIn == "Manual" and timeframe.in_seconds(htfMan) > timeframe.in_seconds() ? htfMan : f_autoHtf()

// Confirmed HTF candles only ([n] offsets + lookahead_on = no repainting).
// [1] is the last closed HTF candle, [3] the first candle of a 3-candle FVG pattern.
[hO3, hH3, hL3, hC3, hT3, hH1, hL1, hT1] = request.security(syminfo.tickerid, htfTf, [open[3], high[3], low[3], close[3], time[3], high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
bool htfNew = not na(hT1) and (na(hT1[1]) or hT1 != hT1[1])

// ─── Types ────────────────────────────────────────────────────────────────────
// Resting liquidity: BSL above swing highs, SSL below swing lows.
type Pool
    float px
    int   bar
    int   t
    int   dir            // +1 buy side (above price) · -1 sell side (below price)
    int   kind
    line  ln
    label lb

// PD array: FVG, iFVG, OB, breaker or HTF POI.
type Zone
    int   id
    float top
    float bot
    int   dir            // +1 bullish (support) · -1 bearish (resistance)
    int   kind
    int   bar            // left edge
    int   made           // bar it became valid (or flipped)
    float anchor         // FVG: first candle's extreme · OB: extreme of the leg it launched
    bool  tx   = false   // drawn on the time axis (HTF)
    bool  dead = false
    box   bx

// One side's narrative: liquidity sweep → extreme → shift.
type Setup
    int   dir
    int   id       = 0
    bool  active   = false
    float lvl                // swept level (deepest pool taken)
    int   kind               // kind of pool taken
    int   sweepBar
    float ext                // sweep extreme
    int   extBar
    float leg                // favourable extreme since the sweep extreme
    bool  fb       = false   // false break: reclaimed within tsBars
    bool  htf      = false   // HTF POI touched or HTF liquidity taken
    float sLvl               // MSS level
    int   sBar
    float cLvl               // CISD level
    bool  shifted  = false
    int   shiftBar
    bool  aSB      = false
    bool  aIFV     = false
    bool  aTS      = false
    int   nCont    = 0

// An armed PD array waiting for tap + confirmation.
type Plan
    int   model
    int   dir
    float top
    float bot
    float anchor             // invalidation extreme
    float leg                // leg's favourable extreme (discount / OTE)
    int   armed
    int   ref                // shift bar: IDM and $ must form after it
    int   zid
    int   pre     = 0        // 0 none · 1 trade beyond preLvl first (M4) · 2 sweep preLvl first (M2 IDM)
    float preLvl
    int   lvlBar
    bool  preOk   = false
    bool  tapped  = false
    int   tapBar
    float tapExt
    float cLvl
    bool  dead    = false
    box   bx

type Trade
    int   model
    int   dir
    float entry
    float sl
    float tp
    int   bar
    bool  live = true
    box   bR
    box   bW

// M4 consolidation.
type Range
    float top
    float bot
    int   left
    int   right
    int   state    = 0       // 0 holding · 1 swept low · -1 swept high · 9 done
    float ext
    int   sweepBar
    bool  htf      = false
    box   bx

// ─── State ────────────────────────────────────────────────────────────────────
var array<Pool>   bsl    = array.new<Pool>()
var array<Pool>   ssl    = array.new<Pool>()
var array<Zone>   fvgs   = array.new<Zone>()
var array<Zone>   obs    = array.new<Zone>()
var array<Zone>   htfZ   = array.new<Zone>()
var array<Plan>   plans  = array.new<Plan>()
var array<Trade>  trades = array.new<Trade>()
var array<float>  ihPx   = array.new<float>()
var array<int>    ihBar  = array.new<int>()
var array<float>  ilPx   = array.new<float>()
var array<int>    ilBar  = array.new<int>()
var array<string> used   = array.new<string>()
var array<int>    SEQ    = array.from(0)
var array<label>  keepSig = array.new<label>()
var array<label>  keepLb  = array.new<label>()
var array<line>   keepLn  = array.new<line>()
var array<box>    keepBx  = array.new<box>()
var Setup bull = Setup.new(dir = 1)
var Setup bear = Setup.new(dir = -1)
var Range rng  = na
var float lastIH    = na
var int   lastIHBar = na
var bool  ihDone    = true
var float lastIL    = na
var int   lastILBar = na
var bool  ilDone    = true
var int   bias      = 0

var array<bool>   mOn  = array.from(enTS, enSB, enUNI, enM1, enM2, enM3, enM4, enIFV, enOBF, enCONT)
var array<string> mTag = array.from("TS", "SB", "UNI", "M1", "M2", "M3", "M4", "iFVG", "OB+FVG", "CONT")
var array<string> mNm  = array.from("Turtle Soup", "Sweep → FVG", "Unicorn", "M1 · Shift + FVG", "M2 · + IDM", "M3 · + OTE", "M4 · Box", "iFVG", "OB + FVG", "Continuation")
var array<int>    stN  = array.new<int>(NM, 0)
var array<int>    stW  = array.new<int>(NM, 0)
var array<int>    stL  = array.new<int>(NM, 0)
var array<float>  stR  = array.new<float>(NM, 0.0)

// ─── Helpers ──────────────────────────────────────────────────────────────────
// History drawings live in capped queues (oldest deleted first), so the platform's
// 500-object limit never removes live PD arrays or recent signals.
f_keepSig(label x) =>
    if not na(x)
        keepSig.push(x)
        if keepSig.size() > 200
            keepSig.shift().delete()
    x

f_keepLb(label x) =>
    if not na(x)
        keepLb.push(x)
        if keepLb.size() > 150
            keepLb.shift().delete()
    x

f_keepLn(line x) =>
    if not na(x)
        keepLn.push(x)
        if keepLn.size() > 200
            keepLn.shift().delete()
    x

f_keepBx(box x) =>
    if not na(x)
        keepBx.push(x)
        if keepBx.size() > 250
            keepBx.shift().delete()
    x

f_id() =>
    SEQ.set(0, SEQ.get(0) + 1)
    SEQ.get(0)

f_col(int d) =>
    d == 1 ? cBull : cBear

f_dirOk(int d) =>
    dirIn == "Both" or (d == 1 and dirIn == "Long only") or (d == -1 and dirIn == "Short only")

f_needHtf(int m) =>
    htfReq == "All models" or (htfReq == "M1–M4 (checklist)" and m >= M1 and m <= M4)

// Adverse / favourable extreme of the current bar for direction d.
f_adv(int d) =>
    d == 1 ? low : high

f_fav(int d) =>
    d == 1 ? high : low

// Further in / against direction d.
f_more(float a, float b, int d) =>
    d == 1 ? math.max(a, b) : math.min(a, b)

f_less(float a, float b, int d) =>
    d == 1 ? math.min(a, b) : math.max(a, b)

// Price came back to lvl (against d).
f_reach(float lvl, int d) =>
    d == 1 ? low <= lvl : high >= lvl

// Price traded through lvl (against d).
f_through(float lvl, int d) =>
    d == 1 ? low < lvl : high > lvl

// Close beyond lvl in direction d.
f_closeBeyond(float lvl, int d) =>
    d == 1 ? close > lvl : close < lvl

// CISD reference: the open of the first candle in the run of opposite candles that
// delivered price into the extreme printed `off` bars ago. A close through it is a
// change in the state of delivery.
f_cisd(int d, int off) =>
    int   i   = off
    float lvl = na
    if d == 1 ? close[i] >= open[i] : close[i] <= open[i]
        i += 1
    while i <= off + 40 and (d == 1 ? close[i] < open[i] : close[i] > open[i])
        lvl := open[i]
        i += 1
    na(lvl) ? (d == 1 ? high[off] : low[off]) : lvl

// Latest internal pivot formed before `before`.
f_lastBefore(array<float> px, array<int> bars, int before) =>
    float p = na
    int   b = na
    int   n = px.size()
    if n > 0
        for i = n - 1 to 0
            if bars.get(i) < before
                p := px.get(i)
                b := bars.get(i)
                break
    [p, b]

f_tags(array<bool> flags) =>
    string s = ""
    for i = 0 to NM - 1
        if flags.get(i)
            s := s == "" ? mTag.get(i) : s + "·" + mTag.get(i)
    s

// ─── Liquidity pools ──────────────────────────────────────────────────────────
f_poolTxt(int d, int k) =>
    k == P_HTF ? (d == 1 ? "HTF H" : "HTF L") : k == P_EQ ? (d == 1 ? "EQH" : "EQL") : (d == 1 ? "BSL" : "SSL")

f_poolDraw(Pool p) =>
    if shLiq
        bool  tx = p.kind == P_HTF
        int   x1 = tx ? p.t : p.bar
        color c  = tx ? cHtf : cLiq
        p.ln := line.new(x1, p.px, tx ? time : bar_index, p.px, xloc = tx ? xloc.bar_time : xloc.bar_index, extend = extend.right, color = color.new(c, 20), style = tx ? line.style_dashed : line.style_dotted, width = 1)
        p.lb := label.new(x1, p.px, f_poolTxt(p.dir, p.kind), xloc = tx ? xloc.bar_time : xloc.bar_index, style = p.dir == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(color.black, 100), textcolor = c, size = size.tiny)

f_addPool(array<Pool> arr, float px, int b, int t, int d, int k) =>
    bool merged = false
    int  n      = arr.size()
    if k == P_SWING and n > 0
        // equal highs / lows: fold into one pool at the outer price
        for i = n - 1 to 0
            Pool q = arr.get(i)
            if q.kind != P_HTF and math.abs(q.px - px) <= eqTol * A
                q.px   := f_more(q.px, px, d)
                q.kind := P_EQ
                q.bar  := b      // reinforced liquidity: restart its life
                if shLiq
                    q.ln.set_y1(q.px)
                    q.ln.set_y2(q.px)
                    q.lb.set_y(q.px)
                    q.lb.set_text(f_poolTxt(d, P_EQ))
                merged := true
                break
    if k == P_HTF and n > 0
        // keep only the latest previous-HTF-candle level per side
        for i = n - 1 to 0
            Pool q = arr.get(i)
            if q.kind == P_HTF
                q.ln.delete()
                q.lb.delete()
                arr.remove(i)
    if not merged
        Pool p = Pool.new(px = px, bar = b, t = t, dir = d, kind = k)
        f_poolDraw(p)
        arr.push(p)
        if arr.size() > 24
            Pool o = arr.shift()
            o.ln.delete()
            o.lb.delete()

// Removes the pools on side d taken by this bar. Returns the outermost level taken,
// whether HTF liquidity was among them and that pool's kind.
f_sweep(array<Pool> arr, int d) =>
    float lvl  = na
    bool  htf  = false
    int   kind = P_SWING
    int   n    = arr.size()
    if n > 0
        for i = n - 1 to 0
            Pool p     = arr.get(i)
            bool taken = d == 1 ? high > p.px : low < p.px
            if taken
                if na(lvl) or (p.px - lvl) * d > 0
                    lvl  := p.px
                    kind := p.kind
                htf := htf or p.kind == P_HTF
                if shLiq
                    p.ln.set_extend(extend.none)
                    p.ln.set_x2(p.kind == P_HTF ? time : bar_index)
                    p.ln.set_color(color.new(p.kind == P_HTF ? cHtf : cLiq, 60))
                    f_keepLn(p.ln)
                    f_keepLb(p.lb)
                arr.remove(i)
            else if bar_index - p.bar > poolLife
                p.ln.delete()
                p.lb.delete()
                arr.remove(i)
    [lvl, htf, kind]

// Closest untaken pool on the target side, optionally one that pays at least minRR.
f_target(int d, float entry, float risk, bool needRR) =>
    array<Pool> arr = ssl
    if d == 1
        arr := bsl
    float best = na
    int   n    = arr.size()
    if n > 0
        for i = 0 to n - 1
            float px = arr.get(i).px
            float rr = (px - entry) * d / risk
            if rr > 0 and (not needRR or rr >= minRR) and (na(best) or (px - best) * d < 0)
                best := px
    best

// ─── PD arrays ────────────────────────────────────────────────────────────────
f_zoneTxt(int k) =>
    k == K_FVG ? "FVG" : k == K_IFVG ? "iFVG" : k == K_OB ? "OB" : k == K_BB ? "BB" : k == K_HFVG ? "HTF FVG" : "HTF OB"

f_zoneStyle(Zone z) =>
    bool  inv = z.kind == K_IFVG or z.kind == K_BB
    color c   = f_col(z.dir)
    z.bx.set_bgcolor(color.new(c, inv ? 90 : 85))
    z.bx.set_border_color(color.new(c, 50))
    z.bx.set_border_style(inv ? line.style_dashed : line.style_solid)
    z.bx.set_text(f_zoneTxt(z.kind))
    z.bx.set_text_color(color.new(c, 20))

f_zoneBox(Zone z) =>
    color c = f_col(z.dir)
    box.new(z.bar, z.top, bar_index, z.bot, border_color = color.new(c, 50), border_width = 1, bgcolor = color.new(c, 85), text = f_zoneTxt(z.kind), text_size = size.tiny, text_color = color.new(c, 20), text_halign = text.align_right, text_valign = text.align_center)

f_newFvg(int d) =>
    Zone z = na
    if d == 1
        z := Zone.new(id = f_id(), top = low, bot = high[2], dir = 1, kind = K_FVG, bar = bar_index - 2, made = bar_index, anchor = low[2])
    else
        z := Zone.new(id = f_id(), top = low[2], bot = high, dir = -1, kind = K_FVG, bar = bar_index - 2, made = bar_index, anchor = high[2])
    if shFvg
        z.bx := f_zoneBox(z)
    fvgs.push(z)
    if fvgs.size() > 40
        Zone o = fvgs.shift()
        o.bx.delete()
    z

// FVG → iFVG when closed through; iFVG dies when closed back through.
f_updFvgs(array<Zone> toBull, array<Zone> toBear) =>
    int n = fvgs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z    = fvgs.get(i)
            bool kill = bar_index - z.made > zoneLife
            bool fail = z.dir == 1 ? close < z.bot : close > z.top
            if fail and not kill
                if z.kind == K_FVG
                    z.kind := K_IFVG
                    z.dir  := -z.dir
                    z.made := bar_index
                    if z.dir == 1
                        toBull.push(z)
                    else
                        toBear.push(z)
                    if shFvg
                        f_zoneStyle(z)
                else
                    kill := true
            if kill
                z.dead := true
                z.bx.delete()
                fvgs.remove(i)

// Order block = last opposite-close candle at the extreme of the move that broke
// internal structure. `span` = bars back to the broken swing.
f_newOb(int d, int span) =>
    int   lim = math.min(span, 150)
    int   off = 1
    float ex  = d == 1 ? low[1] : high[1]
    for j = 1 to lim
        float v = d == 1 ? low[j] : high[j]
        if (v - ex) * d < 0
            ex  := v
            off := j
    int ob = off
    for j = off to math.min(off + 3, lim)
        if d == 1 ? close[j] < open[j] : close[j] > open[j]
            ob := j
            break
    Zone z = Zone.new(id = f_id(), top = high[ob], bot = low[ob], dir = d, kind = K_OB, bar = bar_index - ob, made = bar_index, anchor = f_fav(d))
    if shOb
        z.bx := f_zoneBox(z)
    obs.push(z)
    if obs.size() > 40
        Zone o = obs.shift()
        o.bx.delete()

// OB → breaker when closed through (tracking the stop run it made first);
// breaker dies when closed back through.
f_updObs(array<Zone> toBull, array<Zone> toBear) =>
    int n = obs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z    = obs.get(i)
            bool kill = bar_index - z.made > zoneLife
            if z.kind == K_OB
                z.anchor := f_more(z.anchor, f_fav(z.dir), z.dir)
            bool fail = z.dir == 1 ? close < z.bot : close > z.top
            if fail and not kill
                if z.kind == K_OB
                    z.kind := K_BB
                    z.dir  := -z.dir
                    z.made := bar_index
                    if z.dir == 1
                        toBull.push(z)
                    else
                        toBear.push(z)
                    if shOb
                        f_zoneStyle(z)
                else
                    kill := true
            if kill
                z.dead := true
                z.bx.delete()
                obs.remove(i)

f_addHtf(int d, int k, float top, float bot, int t0) =>
    Zone z = Zone.new(id = f_id(), top = top, bot = bot, dir = d, kind = k, bar = bar_index, made = bar_index, tx = true)
    if shHtf
        z.bx := box.new(t0, top, time, bot, xloc = xloc.bar_time, border_color = color.new(cHtf, 50), border_width = 1, bgcolor = color.new(cHtf, 88), text = f_zoneTxt(k) + " " + f_tfTxt(htfTf) + (d == 1 ? " ▲" : " ▼"), text_size = size.tiny, text_color = color.new(cHtf, 10), text_halign = text.align_right, text_valign = text.align_center)
    htfZ.push(z)
    int cnt = 0
    for i = htfZ.size() - 1 to 0
        Zone q = htfZ.get(i)
        if q.dir == d
            cnt += 1
            if cnt > htfKeep
                q.bx.delete()
                htfZ.remove(i)

f_updHtf() =>
    int n = htfZ.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = htfZ.get(i)
            if (z.dir == 1 ? close < z.bot : close > z.top) or bar_index - z.made > zoneLife * 4
                z.bx.delete()
                htfZ.remove(i)

// Did [lo, hi] trade into an HTF POI of side d?
f_htfTouch(int d, float hi, float lo) =>
    bool hit = false
    int  n   = htfZ.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = htfZ.get(i)
            if z.dir == d and lo <= z.top and hi >= z.bot
                hit := true
                break
    hit

// ─── Narrative ────────────────────────────────────────────────────────────────
// Advances one side: liquidity sweep → sweep extreme → shift. Returns true on the shift bar.
method run(Setup s, float swLvl, bool swHtf, int swKind) =>
    int  d        = s.dir
    bool didShift = false
    bool fresh    = false
    if s.active
        if s.shifted and f_through(s.ext, d)
            s.active := false
        else if not s.shifted and bar_index - s.sweepBar > maxShift
            s.active := false
        else if s.shifted and bar_index - s.shiftBar > setupLife
            s.active := false
    if not na(swLvl) and (not s.active or not s.shifted)
        if not s.active
            s.active  := true
            s.id      := s.id + 1
            s.lvl     := swLvl
            s.kind    := swKind
            s.ext     := f_adv(d)
            s.extBar  := bar_index
            s.leg     := f_fav(d)
            s.fb      := false
            s.htf     := swHtf
            s.shifted := false
            s.aSB     := false
            s.aIFV    := false
            s.aTS     := false
            s.nCont   := 0
            fresh     := true
        else if (swLvl - s.lvl) * d < 0
            s.lvl  := swLvl
            s.kind := swKind
        s.htf      := s.htf or swHtf
        s.sweepBar := bar_index
        if shStr
            f_keepLb(label.new(bar_index, swLvl, "", style = label.style_xcross, color = C_SWEEP, size = size.tiny, tooltip = "Liquidity taken: " + f_poolTxt(-d, swKind)))
    if s.active and not s.shifted
        if not fresh and f_through(s.ext, d)
            s.ext    := f_adv(d)
            s.extBar := bar_index
            s.leg    := f_fav(d)
            s.aSB    := false
            s.aIFV   := false
            fresh    := true
        else
            s.leg := f_more(s.leg, f_fav(d), d)
        if fresh
            s.cLvl := f_cisd(d, 0)
        if not s.htf and f_htfTouch(d, high, low)
            s.htf := true
        if not s.fb and bar_index - s.sweepBar <= tsBars and f_closeBeyond(s.lvl, d)
            s.fb := true
        if d == 1
            [lvU, lbU] = f_lastBefore(ihPx, ihBar, s.extBar)
            s.sLvl := lvU
            s.sBar := lbU
        else
            [lvD, lbD] = f_lastBefore(ilPx, ilBar, s.extBar)
            s.sLvl := lvD
            s.sBar := lbD
        bool mss = not na(s.sLvl) and f_closeBeyond(s.sLvl, d)
        bool cis = not na(s.cLvl) and f_closeBeyond(s.cLvl, d)
        bool go  = shiftIn == "MSS" ? mss : shiftIn == "CISD" ? cis : mss or cis
        if go
            s.shifted  := true
            s.shiftBar := bar_index
            didShift   := true
            if shStr
                bool  byM = mss and shiftIn != "CISD"
                float y   = byM ? s.sLvl : s.cLvl
                int   x1  = byM ? s.sBar : s.extBar
                f_keepLn(line.new(x1, y, bar_index, y, color = f_col(d), style = byM ? line.style_solid : line.style_dashed, width = 1))
                f_keepLb(label.new(math.round((x1 + bar_index) / 2), y, byM ? "MSS" : "CISD", style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = f_col(d), size = size.tiny))
    else if s.active
        s.leg := f_more(s.leg, f_fav(d), d)
    didShift

// ─── Plans ────────────────────────────────────────────────────────────────────
f_arm(int m, int d, float top, float bot, float anchor, float leg, int ref, int zid, int pre, float preLvl, bool htfOk) =>
    bool   ok  = mOn.get(m) and f_dirOk(d) and (htfOk or not f_needHtf(m))
    string key = str.tostring(m) + "|" + str.tostring(d) + "|" + str.tostring(zid)
    if ok and zid != 0
        ok := not used.includes(key)
    if ok
        if zid != 0
            used.push(key)
            if used.size() > 400
                used.shift()
        Plan p = Plan.new(model = m, dir = d, top = top, bot = bot, anchor = anchor, leg = leg, armed = bar_index, ref = ref, zid = zid, pre = pre, preLvl = preLvl)
        if shPlan and not na(top) and not na(bot)
            color c = f_col(d)
            p.bx := box.new(bar_index, top, bar_index + 1, bot, border_color = color.new(c, 30), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(c, 90), text = mTag.get(m), text_size = size.tiny, text_color = c, text_halign = text.align_left, text_valign = text.align_center)
        plans.push(p)
        if plans.size() > 80
            Plan o = plans.shift()
            o.bx.delete()
    ok

// OB that launched the displacement and sits right under (over) FVG f.
f_convOb(int d, int fromBar, Zone f) =>
    Zone best = na
    int  n    = obs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = obs.get(i)
            if z.kind == K_OB and z.dir == d and z.bar >= fromBar - 3 and z.bar <= f.bar + 1
                float gap     = d == 1 ? f.bot - z.top : z.bot - f.top
                bool  beneath = d == 1 ? z.bot < f.bot : z.top > f.top
                if gap <= obfTol * A and beneath
                    best := z
                    break
    best

// M1 / M2 / M3 / OB+FVG on every FVG printed by the shift leg. Returns plans armed.
f_armLeg(Setup s) =>
    int d     = s.dir
    int armed = 0
    int n     = fvgs.size()
    if n > 0
        for i = n - 1 to 0
            Zone f = fvgs.get(i)
            if f.kind == K_FVG and f.dir == d and f.bar >= s.extBar - 1
                armed += f_arm(M1, d, f.top, f.bot, s.ext, s.leg, s.shiftBar, f.id, 0, na, s.htf) ? 1 : 0
                armed += f_arm(M2, d, f.top, f.bot, s.ext, s.leg, s.shiftBar, f.id, 2, na, s.htf) ? 1 : 0
                armed += f_arm(M3, d, f.top, f.bot, s.ext, s.leg, s.shiftBar, f.id, 0, na, s.htf) ? 1 : 0
                Zone ob = f_convOb(d, s.extBar, f)
                if not na(ob)
                    armed += f_arm(OBF, d, ob.top, ob.bot, s.ext, s.leg, s.shiftBar, ob.id, 0, na, s.htf) ? 1 : 0
    armed

// Setup-driven models for one side. Returns plans armed.
f_armSide(Setup s, bool justShifted, Zone newF, array<Zone> inv) =>
    int d     = s.dir
    int armed = 0
    if s.active
        // Sweep → FVG: first displacement FVG off the sweep extreme
        if not s.aSB and not na(newF) and newF.bar >= s.extBar - 1 and bar_index - s.sweepBar <= sbBars
            s.aSB := true
            armed += f_arm(SB, d, newF.top, newF.bot, s.ext, s.leg, bar_index, newF.id, 0, na, s.htf) ? 1 : 0
        // iFVG: an opposing FVG closed through after the sweep
        if not s.aIFV and inv.size() > 0 and bar_index - s.extBar <= ifvBars
            Zone z = inv.get(inv.size() - 1)
            s.aIFV := true
            armed += f_arm(IFV, d, z.top, z.bot, s.ext, s.leg, bar_index, z.id, 0, na, s.htf) ? 1 : 0
        if s.shifted
            if bar_index <= s.shiftBar + grace
                armed += f_armLeg(s)
            // Turtle Soup: only after a genuine false break; the $ level fills in later
            if justShifted and s.fb and not s.aTS
                s.aTS := true
                float tTop = d == 1 ? na : s.ext
                float tBot = d == 1 ? s.ext : na
                armed += f_arm(TS, d, tTop, tBot, s.ext, s.leg, s.shiftBar, 0, 0, na, s.htf) ? 1 : 0
            // Continuation FVGs after the shift leg
            if not na(newF) and bar_index > s.shiftBar + grace and s.nCont < contMax
                s.nCont := s.nCont + 1
                armed += f_arm(CONT, d, newF.top, newF.bot, newF.anchor, s.leg, bar_index, newF.id, 0, na, s.htf) ? 1 : 0
    armed

// Unicorn: breaker ∩ FVG of the same direction.
f_uniPair(Zone bb, Zone f) =>
    float top = math.min(bb.top, f.top)
    float bot = math.max(bb.bot, f.bot)
    bool  ok  = false
    if top > bot and bb.made - bb.bar <= uniAge
        int  d = f.dir
        bool h = d == 1 ? f_htfTouch(1, bb.top, bb.anchor) : f_htfTouch(-1, bb.anchor, bb.bot)
        ok := f_arm(UNI, d, top, bot, bb.anchor, na, bar_index, bb.id * 100000 + f.id, 0, na, h)
    ok

// Returns plans armed.
f_armUni(array<Zone> flips, Zone newF) =>
    int armed = 0
    // breakers flipped this bar ↔ FVGs printed shortly before
    int nf = flips.size()
    if nf > 0
        for i = 0 to nf - 1
            Zone bb = flips.get(i)
            int  n1 = fvgs.size()
            if n1 > 0
                for j = n1 - 1 to 0
                    Zone f = fvgs.get(j)
                    if f.kind == K_FVG and f.dir == bb.dir and bar_index - f.made <= uniBars
                        armed += f_uniPair(bb, f) ? 1 : 0
    // FVG printed this bar ↔ breakers flipped shortly before
    if not na(newF)
        int n2 = obs.size()
        if n2 > 0
            for j = n2 - 1 to 0
                Zone bb = obs.get(j)
                if bb.kind == K_BB and bb.dir == newF.dir and bar_index - bb.made <= uniBars
                    armed += f_uniPair(bb, newF) ? 1 : 0
    armed

// Tap → confirmation for every armed plan. Confirmed plans are pushed to `fired`.
f_runPlans(array<Plan> fired) =>
    int n = plans.size()
    if n > 0
        for i = n - 1 to 0
            Plan p    = plans.get(i)
            int  d    = p.dir
            bool kill = false
            if bar_index > p.armed
                // levels that keep forming until the tap
                if not p.tapped
                    p.leg := f_more(p.leg, f_fav(d), d)
                    float nI = d == 1 ? ipl : iph
                    if not na(nI) and bar_index - intLen > p.ref
                        // TS: internal liquidity ($) formed after the shift
                        if p.model == TS and (nI - p.anchor) * d > 0
                            if d == 1
                                p.top := nI
                            else
                                p.bot := nI
                            p.lvlBar := bar_index - intLen
                        // M2: inducement beyond the FVG
                        if p.pre == 2 and not p.preOk and (d == 1 ? nI > p.top : nI < p.bot)
                            p.preLvl := nI
                            p.lvlBar := bar_index - intLen
                if p.pre == 2 and not p.preOk and not na(p.preLvl) and f_through(p.preLvl, d)
                    p.preOk := true
                    if shStr
                        f_keepLn(line.new(p.lvlBar, p.preLvl, bar_index, p.preLvl, color = color.new(f_col(d), 20), style = line.style_dashed, width = 1))
                        f_keepLb(label.new(math.round((p.lvlBar + bar_index) / 2), p.preLvl, "IDM", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = f_col(d), size = size.tiny))
                // invalidation
                if f_through(p.anchor, d)
                    kill := true
                if p.model != TS and not na(p.top) and not na(p.bot) and (d == 1 ? close < p.bot : close > p.top)
                    kill := true
                if bar_index - p.armed > planLife
                    kill := true
                // tap
                if not kill and not p.tapped and not na(p.top) and not na(p.bot)
                    float edge  = d == 1 ? p.top : p.bot
                    bool  touch = p.model == TS ? f_through(edge, d) : f_reach(edge, d)
                    if touch
                        if p.pre == 2 and not p.preOk
                            kill := true
                        else if p.pre == 0 or p.preOk
                            float tl = p.model == TS or tapIn == "Zone edge" ? edge : (p.top + p.bot) / 2
                            float rg = math.abs(p.leg - p.anchor)
                            if p.model == M1
                                // FVG must reach into discount (premium for shorts) of the shift leg
                                float eq = p.anchor + 0.5 * rg * d
                                if d == 1 ? p.bot > eq : p.top < eq
                                    kill := true
                            if p.model == M3
                                // FVG must overlap OTE 0.62–0.79, and price must reach 0.62
                                float o62 = p.leg - 0.62 * rg * d
                                float o79 = p.leg - 0.79 * rg * d
                                bool  ovl = d == 1 ? p.bot <= o62 and p.top >= o79 : p.top >= o62 and p.bot <= o79
                                if ovl
                                    tl := f_less(tl, o62, d)
                                else
                                    kill := true
                            if not kill and (p.model == TS or f_reach(tl, d))
                                p.tapped := true
                                p.tapBar := bar_index
                                p.tapExt := f_adv(d)
                                p.cLvl   := f_cisd(d, 0)
                else if not kill and p.tapped
                    if f_through(p.tapExt, d)
                        p.tapExt := f_adv(d)
                        p.cLvl   := f_cisd(d, 0)
                // M4: price has to leave the box first; the breakout bar itself is not the retest
                if p.pre == 1 and not p.preOk
                    p.preOk := d == 1 ? high > p.preLvl : low < p.preLvl
                // confirmation: market entry on this close
                if not kill and p.tapped
                    bool ok = false
                    if p.model == TS
                        ok := f_closeBeyond(d == 1 ? p.top : p.bot, d)
                        if not ok and bar_index - p.tapBar >= tsBars
                            kill := true
                    else if confIn == "CISD"
                        ok := f_closeBeyond(p.cLvl, d)
                    else if confIn == "Rejection close"
                        ok := f_closeBeyond(d == 1 ? p.top : p.bot, d) and (d == 1 ? close > open : close < open)
                    else
                        ok := d == 1 ? close > open : close < open
                    if ok and not kill
                        fired.push(p)
                        p.dead := true
                    else if not kill and p.model != TS and bar_index - p.tapBar >= confBars
                        p.tapped := false
            if kill
                p.dead := true
                p.bx.delete()
            if p.dead
                plans.remove(i)

f_hasOpen(int m, int d) =>
    bool has = false
    int  n   = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trade t = trades.get(i)
            if t.live and t.model == m and t.dir == d
                has := true
                break
    has

// Stop first when both levels print on one bar (conservative).
f_runTrades() =>
    int n = trades.size()
    if n > 0
        for i = n - 1 to 0
            Trade t = trades.get(i)
            if bar_index > t.bar
                bool hitS = f_reach(t.sl, t.dir)
                bool hitT = t.dir == 1 ? high >= t.tp : low <= t.tp
                if hitS or hitT
                    t.live := false
                    if hitS
                        stL.set(t.model, stL.get(t.model) + 1)
                        stR.set(t.model, stR.get(t.model) - 1.0)
                    else
                        stW.set(t.model, stW.get(t.model) + 1)
                        stR.set(t.model, stR.get(t.model) + math.abs(t.tp - t.entry) / math.abs(t.entry - t.sl))
                    if not na(t.bR)
                        t.bR.set_right(bar_index)
                        t.bW.set_right(bar_index)
                    trades.remove(i)

f_tip(int d, string tags, float e, float sl, float tp) =>
    string head = (d == 1 ? "LONG · " : "SHORT · ") + tags
    head + "\nEntry (market on close): " + str.tostring(e, format.mintick) + "\nStop: " + str.tostring(sl, format.mintick) + "\nTarget: " + str.tostring(tp, format.mintick) + "\nR:R " + str.tostring(math.abs(tp - e) / math.abs(e - sl), "#.##")

// ─── Engine (bar close only → no intrabar repaint) ────────────────────────────
bool   longSig  = false
bool   shortSig = false
float  sigDir   = 0.0
float  sigEntry = na
float  sigSL    = na
float  sigTP    = na
string sigTag   = ""

if barstate.isconfirmed
    f_runTrades()

    // internal structure
    if not na(iph)
        ihPx.push(iph)
        ihBar.push(bar_index - intLen)
        if ihPx.size() > 30
            ihPx.shift()
            ihBar.shift()
        lastIH    := iph
        lastIHBar := bar_index - intLen
        ihDone    := false
    if not na(ipl)
        ilPx.push(ipl)
        ilBar.push(bar_index - intLen)
        if ilPx.size() > 30
            ilPx.shift()
            ilBar.shift()
        lastIL    := ipl
        lastILBar := bar_index - intLen
        ilDone    := false

    // liquidity pools
    if not na(ph)
        f_addPool(bsl, ph, bar_index - extLen, time[extLen], 1, P_SWING)
    if not na(pl)
        f_addPool(ssl, pl, bar_index - extLen, time[extLen], -1, P_SWING)
    if htfNew and htfLiqOn and not na(hH1) and not na(hL1)
        f_addPool(bsl, hH1, bar_index, hT1, 1, P_HTF)
        f_addPool(ssl, hL1, bar_index, hT1, -1, P_HTF)

    // HTF POIs
    f_updHtf()
    if htfNew and not na(hH3) and not na(hL1)
        if hL1 > hH3
            if htfFvgOn
                f_addHtf(1, K_HFVG, hL1, hH3, hT3)
            if htfObOn and hC3 < hO3
                f_addHtf(1, K_HOB, hH3, hL3, hT3)
        if hH1 < hL3
            if htfFvgOn
                f_addHtf(-1, K_HFVG, hL3, hH1, hT3)
            if htfObOn and hC3 > hO3
                f_addHtf(-1, K_HOB, hH3, hL3, hT3)

    // liquidity taken this bar
    [sslLvl, sslHtf, sslKind] = f_sweep(ssl, -1)
    [bslLvl, bslHtf, bslKind] = f_sweep(bsl, 1)

    // PD arrays
    array<Zone> fvgToBull = array.new<Zone>()
    array<Zone> fvgToBear = array.new<Zone>()
    array<Zone> obToBull  = array.new<Zone>()
    array<Zone> obToBear  = array.new<Zone>()
    f_updFvgs(fvgToBull, fvgToBear)
    Zone newBullF = na
    Zone newBearF = na
    if bullFvg
        newBullF := f_newFvg(1)
    if bearFvg
        newBearF := f_newFvg(-1)
    f_updObs(obToBull, obToBear)
    if not ihDone and not na(lastIH) and close > lastIH
        ihDone := true
        f_newOb(1, bar_index - lastIHBar)
    if not ilDone and not na(lastIL) and close < lastIL
        ilDone := true
        f_newOb(-1, bar_index - lastILBar)

    // narratives
    bool bullShift = bull.run(sslLvl, sslHtf, sslKind)
    bool bearShift = bear.run(bslLvl, bslHtf, bslKind)
    if bullShift
        bias := 1
        if bear.active and bear.shifted
            bear.active := false
    if bearShift
        bias := -1
        if bull.active and bull.shifted
            bull.active := false

    // armed plans: tap → confirmation (before arming anything new)
    array<Plan> fired = array.new<Plan>()
    f_runPlans(fired)

    // arm new plans
    f_armSide(bull, bullShift, newBullF, fvgToBull)
    f_armSide(bear, bearShift, newBearF, fvgToBear)
    f_armUni(obToBear, newBearF)
    f_armUni(obToBull, newBullF)

    // M4 · consolidation → sweep → reclaim
    if na(rng) or rng.state == 9
        if tight
            rng := Range.new(top = rHi[1], bot = rLo[1], left = bar_index - boxLen, right = bar_index - 1)
            if shBox
                rng.bx := f_keepBx(box.new(rng.left, rng.top, rng.right, rng.bot, border_color = color.new(cLiq, 50), border_width = 1, bgcolor = color.new(cLiq, 88), text = "Consolidation", text_size = size.tiny, text_color = color.new(cLiq, 10), text_halign = text.align_center, text_valign = text.align_top))
    if not na(rng)
        if rng.state == 0
            bool dn = low < rng.bot
            bool up = high > rng.top
            if dn and up
                rng.state := 9
            else if dn or up
                rng.state    := dn ? 1 : -1
                rng.ext      := dn ? low : high
                rng.sweepBar := bar_index
                rng.htf      := dn ? sslHtf or f_htfTouch(1, high, low) : bslHtf or f_htfTouch(-1, high, low)
            else
                rng.right := bar_index
                if shBox
                    rng.bx.set_right(bar_index)
        if rng.state == 1 or rng.state == -1
            int rd = rng.state
            if f_through(rng.ext, rd)
                rng.ext := f_adv(rd)
                rng.htf := rng.htf or f_htfTouch(rd, high, low) or (rd == 1 ? sslHtf : bslHtf)
            if f_closeBeyond(rd == 1 ? rng.bot : rng.top, rd)
                f_arm(M4, rd, rng.top, rng.bot, rng.ext, na, bar_index, 0, 1, rd == 1 ? rng.top : rng.bot, rng.htf)
                rng.state := 9
            else if bar_index - rng.sweepBar >= boxBars
                rng.state := 9

    // confirmed plans → trades
    array<bool> firedL = array.new<bool>(NM, false)
    array<bool> firedS = array.new<bool>(NM, false)
    float eL  = na
    float slL = na
    float tpL = na
    float eS  = na
    float slS = na
    float tpS = na
    int nF = fired.size()
    if nF > 0
        for i = 0 to nF - 1
            Plan  p     = fired.get(i)
            int   d     = p.dir
            float entry = close
            float base  = stopIn == "Sweep extreme" ? p.anchor : p.model == TS ? p.tapExt : f_less(d == 1 ? p.bot : p.top, p.tapExt, d)
            float sl    = base - d * stopBuf * A
            float risk  = (entry - sl) * d
            bool  take  = risk > 0 and (not onePer or not f_hasOpen(p.model, d))
            float tp    = na
            if take
                if tpIn == "Fixed R"
                    tp := entry + d * fixR * risk
                else
                    tp := f_target(d, entry, risk, tpIn == "Liquidity ≥ min R:R")
                    if na(tp) and not na(p.leg) and (p.leg - entry) * d >= minRR * risk
                        tp := p.leg
                    if na(tp)
                        tp := entry + d * fixR * risk
                take := tpIn == "Fixed R" or (tp - entry) * d >= minRR * risk
            if take
                bool  first = d == 1 ? na(eL) : na(eS)
                Trade t     = Trade.new(model = p.model, dir = d, entry = entry, sl = sl, tp = tp, bar = bar_index)
                if shTrade and first
                    t.bR := f_keepBx(box.new(bar_index, entry, bar_index + 1, sl, border_color = color.new(cLoss, 60), border_width = 1, bgcolor = color.new(cLoss, 85)))
                    t.bW := f_keepBx(box.new(bar_index, tp, bar_index + 1, entry, border_color = color.new(cWin, 60), border_width = 1, bgcolor = color.new(cWin, 85)))
                trades.push(t)
                stN.set(p.model, stN.get(p.model) + 1)
                if not na(p.bx)
                    p.bx.set_right(bar_index)
                    f_keepBx(p.bx)
                if p.model == TS and shStr
                    float lvl = d == 1 ? p.top : p.bot
                    f_keepLn(line.new(p.lvlBar, lvl, bar_index, lvl, color = color.new(f_col(d), 20), style = line.style_dashed, width = 1))
                    f_keepLb(label.new(p.lvlBar, lvl, "$", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = f_col(d), size = size.small))
                if d == 1
                    firedL.set(p.model, true)
                    if first
                        eL  := entry
                        slL := sl
                        tpL := tp
                else
                    firedS.set(p.model, true)
                    if first
                        eS  := entry
                        slS := sl
                        tpS := tp
            else
                p.bx.delete()

    if not na(eL)
        string tags = f_tags(firedL)
        f_keepSig(label.new(bar_index, low, "▲ " + tags, yloc = yloc.belowbar, style = label.style_label_up, color = cBull, textcolor = color.white, size = size.small, tooltip = f_tip(1, tags, eL, slL, tpL)))
        alert("ICT FM LONG [" + tags + "] " + syminfo.ticker + " " + timeframe.period + " | entry " + str.tostring(eL, format.mintick) + " | SL " + str.tostring(slL, format.mintick) + " | TP " + str.tostring(tpL, format.mintick), alert.freq_once_per_bar_close)
        longSig := true
    if not na(eS)
        string tags = f_tags(firedS)
        f_keepSig(label.new(bar_index, high, "▼ " + tags, yloc = yloc.abovebar, style = label.style_label_down, color = cBear, textcolor = color.white, size = size.small, tooltip = f_tip(-1, tags, eS, slS, tpS)))
        alert("ICT FM SHORT [" + tags + "] " + syminfo.ticker + " " + timeframe.period + " | entry " + str.tostring(eS, format.mintick) + " | SL " + str.tostring(slS, format.mintick) + " | TP " + str.tostring(tpS, format.mintick), alert.freq_once_per_bar_close)
        shortSig := true
    if longSig and not shortSig
        sigDir   := 1
        sigEntry := eL
        sigSL    := slL
        sigTP    := tpL
        sigTag   := f_tags(firedL)
    if shortSig and not longSig
        sigDir   := -1
        sigEntry := eS
        sigSL    := slS
        sigTP    := tpS
        sigTag   := f_tags(firedS)

// ─── Live drawings & dashboard ────────────────────────────────────────────────
f_pos(string s) =>
    s == "Top right" ? position.top_right : s == "Bottom right" ? position.bottom_right : s == "Top left" ? position.top_left : position.bottom_left

f_live(int m) =>
    bool l = false
    bool s = false
    int  n = plans.size()
    if n > 0
        for i = 0 to n - 1
            Plan p = plans.get(i)
            if p.model == m
                if p.dir == 1
                    l := true
                else
                    s := true
    (l ? "▲" : "") + (s ? "▼" : "")

f_planTags(int d, bool tapped) =>
    array<bool> f = array.new<bool>(NM, false)
    int         n = plans.size()
    if n > 0
        for i = 0 to n - 1
            Plan p = plans.get(i)
            if p.dir == d and p.tapped == tapped
                f.set(p.model, true)
    string s = f_tags(f)
    s == "" ? "—" : s

f_grab(Setup s) =>
    s.active ? "✔ " + f_poolTxt(-s.dir, s.kind) : "—"

f_mark(Setup s, bool b) =>
    s.active and b ? "✔" : "—"

f_extend() =>
    int n1 = fvgs.size()
    if n1 > 0
        for i = 0 to n1 - 1
            Zone z = fvgs.get(i)
            if not na(z.bx)
                z.bx.set_right(bar_index + 3)
    int n2 = obs.size()
    if n2 > 0
        for i = 0 to n2 - 1
            Zone z = obs.get(i)
            if not na(z.bx)
                z.bx.set_right(bar_index + 3)
    int n3 = htfZ.size()
    if n3 > 0
        for i = 0 to n3 - 1
            Zone z = htfZ.get(i)
            if not na(z.bx)
                z.bx.set_right(time)
    int n4 = plans.size()
    if n4 > 0
        for i = 0 to n4 - 1
            Plan p = plans.get(i)
            if not na(p.bx)
                p.bx.set_right(bar_index)
    int n5 = trades.size()
    if n5 > 0
        for i = 0 to n5 - 1
            Trade t = trades.get(i)
            if not na(t.bR)
                t.bR.set_right(bar_index)
                t.bW.set_right(bar_index)

if barstate.islast
    f_extend()
    if shDash
        var table tb = table.new(f_pos(dashPos), 5, NM + 9, bgcolor = color.new(#131722, 5), frame_color = #434651, frame_width = 1, border_color = #2a2e39, border_width = 1)
        color hd  = #2a2e39
        color tx  = #d1d4dc
        color dim = #5d606b
        tb.cell(0, 0, "ICT Fractal Models", text_color = color.white, bgcolor = hd, text_size = size.small, text_halign = text.align_left)
        tb.cell(1, 0, f_tfTxt(timeframe.period), text_color = tx, bgcolor = hd, text_size = size.small)
        tb.cell(2, 0, "HTF " + f_tfTxt(htfTf), text_color = cHtf, bgcolor = hd, text_size = size.small)
        tb.cell(3, 0, "Bias", text_color = tx, bgcolor = hd, text_size = size.small)
        tb.cell(4, 0, bias == 1 ? "▲" : bias == -1 ? "▼" : "—", text_color = bias == 1 ? cBull : bias == -1 ? cBear : tx, bgcolor = hd, text_size = size.small)
        tb.cell(0, 1, "Model", text_color = dim, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, 1, "Trades", text_color = dim, text_size = size.tiny)
        tb.cell(2, 1, "Win %", text_color = dim, text_size = size.tiny)
        tb.cell(3, 1, "Σ R", text_color = dim, text_size = size.tiny)
        tb.cell(4, 1, "Armed", text_color = dim, text_size = size.tiny)
        for m = 0 to NM - 1
            bool  isOn = mOn.get(m)
            int   w    = stW.get(m)
            int   l    = stL.get(m)
            float r    = stR.get(m)
            color c    = isOn ? tx : dim
            tb.cell(0, m + 2, mNm.get(m), text_color = c, text_size = size.tiny, text_halign = text.align_left)
            tb.cell(1, m + 2, isOn ? str.tostring(stN.get(m)) : "off", text_color = c, text_size = size.tiny)
            tb.cell(2, m + 2, w + l > 0 ? str.tostring(100.0 * w / (w + l), "#") + "%" : "—", text_color = c, text_size = size.tiny)
            tb.cell(3, m + 2, w + l > 0 ? (r >= 0 ? "+" : "") + str.tostring(r, "#.#") : "—", text_color = w + l == 0 ? c : r >= 0 ? cWin : cLoss, text_size = size.tiny)
            tb.cell(4, m + 2, f_live(m), text_color = c, text_size = size.tiny)
        int r0 = NM + 2
        tb.cell(0, r0, "Checklist", text_color = color.white, bgcolor = hd, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0, "Long", text_color = cBull, bgcolor = hd, text_size = size.tiny)
        tb.cell(2, r0, "Short", text_color = cBear, bgcolor = hd, text_size = size.tiny)
        tb.cell(0, r0 + 1, "Liquidity grab", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 1, f_grab(bull), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 1, f_grab(bear), text_color = tx, text_size = size.tiny)
        tb.cell(0, r0 + 2, "False break (TS)", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 2, f_mark(bull, bull.fb), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 2, f_mark(bear, bear.fb), text_color = tx, text_size = size.tiny)
        tb.cell(0, r0 + 3, "HTF POI / liquidity", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 3, f_mark(bull, bull.htf), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 3, f_mark(bear, bear.htf), text_color = tx, text_size = size.tiny)
        tb.cell(0, r0 + 4, "Shift (" + shiftIn + ")", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 4, f_mark(bull, bull.shifted), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 4, f_mark(bear, bear.shifted), text_color = tx, text_size = size.tiny)
        tb.cell(0, r0 + 5, "PD array armed", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 5, f_planTags(1, false), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 5, f_planTags(-1, false), text_color = tx, text_size = size.tiny)
        tb.cell(0, r0 + 6, "Tapped · awaiting close", text_color = tx, text_size = size.tiny, text_halign = text.align_left)
        tb.cell(1, r0 + 6, f_planTags(1, true), text_color = tx, text_size = size.tiny)
        tb.cell(2, r0 + 6, f_planTags(-1, true), text_color = tx, text_size = size.tiny)

// ─── Outputs ──────────────────────────────────────────────────────────────────
plot(sigDir, "Signal (+1 long / -1 short)", display = display.data_window)
plot(sigEntry, "Entry", display = display.data_window)
plot(sigSL, "Stop", display = display.data_window)
plot(sigTP, "Target", display = display.data_window)
alertcondition(longSig, "ICT FM · Long", "ICT Fractal Models: long on {{ticker}} {{interval}} at {{close}}") // @ind
alertcondition(shortSig, "ICT FM · Short", "ICT Fractal Models: short on {{ticker}} {{interval}} at {{close}}") // @ind
alertcondition(longSig or shortSig, "ICT FM · Any signal", "ICT Fractal Models: signal on {{ticker}} {{interval}} at {{close}}") // @ind

// ─── Strategy execution (strategy build only) ─────────────────────────────────
// Market entry on the confirmation close (process_orders_on_close); stop and
// target are exit orders. No entry is ever a limit order.
//@S float riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, step = 0.1, group = "Strategy")
//@S if sigDir != 0 and strategy.position_size == 0
//@S     float  qty = strategy.equity * riskPct / 100 / (math.abs(sigEntry - sigSL) * syminfo.pointvalue)
//@S     string eid = sigDir == 1 ? "Long" : "Short"
//@S     strategy.entry(eid, sigDir == 1 ? strategy.long : strategy.short, qty = qty, comment = sigTag)
//@S     strategy.exit(eid + " exit", from_entry = eid, stop = sigSL, limit = sigTP, comment_loss = "SL", comment_profit = "TP")
